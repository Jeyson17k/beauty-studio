# Copia este archivo como .env.local y ajusta los valores.

# Base de datos PostgreSQL 16 (usuario, contraseña, servidor, puerto y base)
DATABASE_URL=postgres://beauty:beauty@localhost:5432/beautystudio_db

# Clave larga y secreta para firmar las sesiones (mínimo 32 caracteres)
SESSION_SECRET=cambia-esta-clave-por-una-larga-y-secreta-123456

# Contraseña inicial de Andrea (usuario: andrea). Se usa solo al crear los datos iniciales.
ADMIN_PASSWORD=BeautyStudio2026!

# Carpeta donde se guardan fotos de referencia y comprobantes (en el VPS será el almacenamiento de objetos)
STORAGE_DIR=./almacenamiento

# Dirección pública del sistema (sirve para enlaces y para el webhook)
APP_URL=http://localhost:3000

# ---- WhatsApp ----
# simulado: no se conecta a Meta; los envíos se registran y el aviso «enviado» se simula a los 2 segundos.
#           Convención de prueba: un número que termina en 9999 simula un envío fallido.
# cloud:    usa Meta WhatsApp Cloud API con las credenciales de abajo (pendiente de probar).
WHATSAPP_MODE=simulado
WHATSAPP_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=cambia-este-token-de-verificacion
WHATSAPP_PLANTILLA_COTIZACION=cotizacion_servicio_v1
WHATSAPP_PLANTILLA_CONFIRMACION=confirmacion_cita_v1
WHATSAPP_PLANTILLA_CODIGO=codigo_verificacion_v1
WHATSAPP_IDIOMA=es

# Clave del planificador (para llamar /api/planificador desde un cron externo en el VPS)
CRON_SECRET=cambia-esta-clave-del-planificador
